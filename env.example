# このファイルを `.env` にコピーして値を設定してください（.env は Git 管理対象外）。

# Google OAuth クライアントID（ウェブアプリケーション種別）
# Google Cloud Console > APIとサービス > 認証情報 で発行。
# 「承認済みの JavaScript 生成元」に開発/本番のオリジンを登録すること:
#   http://localhost:5173
#   https://<user>.github.io
VITE_GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com

# 任意: 既定で作成するスプレッドシートのタイトル
VITE_SPREADSHEET_TITLE=CardLedger Data
